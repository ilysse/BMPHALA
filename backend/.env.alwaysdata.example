APP_NAME="Halawat Lil Moaamalat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql-YOUR_ACCOUNT.alwaysdata.net
DB_PORT=3306
DB_DATABASE=YOUR_ACCOUNT_DATABASE
DB_USERNAME=YOUR_ACCOUNT_USER
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

FIREBASE_PROJECT_ID=halawatapp
FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@YOUR_DOMAIN
MAIL_FROM_NAME="${APP_NAME}"

OTP_DEFAULT_CHANNEL=sms
OTP_CODE_TTL_MINUTES=5
SMS_GATEWAY_TOKEN=GENERATE_A_LONG_RANDOM_VALUE
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_login
WHATSAPP_WEBHOOK_VERIFY_TOKEN=GENERATE_A_LONG_RANDOM_VALUE
DEPLOY_SETUP_TOKEN=GENERATE_A_LONG_RANDOM_VALUE
